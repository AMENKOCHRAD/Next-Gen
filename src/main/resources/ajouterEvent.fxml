<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="boutons.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ajouterEvent">
    <!-- Conteneur principal centré -->
    <VBox alignment="CENTER" layoutX="223.0" layoutY="70.0" prefHeight="416.0" prefWidth="407.0" spacing="10">
        <!-- Titre de la page -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: FFFF;" text="Ajouter un événement" textFill="#faf8f8">
            <font>
                <Font name="Roboto Bold" size="24" />
            </font>
        </Label>

        <!-- Champ pour le nom de l'événement -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 14px; -fx-text-fill: FFFF;" text="Nom de l'événement" />
            <TextField fx:id="nomEvent" promptText="Entrez le nom de l'événement" style="-fx-font-size: 14px; -fx-pref-width: 300px;" />
        </VBox>

        <!-- Champ pour le type de l'événement -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 14px; -fx-text-fill: FFFF;" text="Type de l'événement" />
            <TextField fx:id="typeEvent" promptText="Entrez le type de l'événement" style="-fx-font-size: 14px; -fx-pref-width: 300px;" />
        </VBox>

        <!-- Champ pour la date de début -->
        <VBox prefHeight="54.0" prefWidth="180.0" spacing="5">
            <Label style="-fx-font-size: 14px; -fx-text-fill: FFFF;" text="Date de début (YYYY-MM-DD)" />
            <TextField fx:id="dateDebutEvent" promptText="Entrez la date de début" style="-fx-font-size: 14px; -fx-pref-width: 300px;" />
        </VBox>

        <!-- Champ pour la date de fin -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 14px; -fx-text-fill: FFFF;" text="Date de fin (YYYY-MM-DD)" />
            <TextField fx:id="dateFinEvent" promptText="Entrez la date de fin" style="-fx-font-size: 14px; -fx-pref-width: 300px;" />
        </VBox>

        <!-- Champ pour le lieu de l'événement -->
        <VBox spacing="5">
            <Label style="-fx-font-size: 14px; -fx-text-fill: FFFF;" text="Lieu de l'événement" />
            <TextField fx:id="lieuEvent" promptText="Entrez le lieu de l'événement" style="-fx-font-size: 14px; -fx-pref-width: 300px;" />
        </VBox>

        <!-- Bouton pour ajouter l'événement -->
        <Button fx:id="addButton" onAction="#handleAddEvent" style="-fx-font-size: 16px; -fx-background-color: #2980b9; -fx-text-fill: white; -fx-pref-width: 200px; -fx-padding: 10px;" text="Ajouter l'événement">
            <font>
                <Font name="Roboto" size="16" />
            </font>
        </Button>
    </VBox>
</AnchorPane>
