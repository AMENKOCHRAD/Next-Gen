<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="875.0" stylesheets="styles.css"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestion.pidev.controllers.CoursFrontController">
    <children>
        <!-- Inclusion de la navbar -->
        <fx:include source="Navbar.fxml" />

        <!-- Titre pour la section des exercices -->
        <Label text="Les exercices guidés par l'intelligence artificielle :"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
               AnchorPane.leftAnchor="220.0" AnchorPane.topAnchor="80.0" />

        <!-- Section des exercices (CoursFrontController) -->
        <HBox alignment="CENTER" spacing="20.0" AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="120.0">
            <VBox fx:id="vbox1" spacing="10.0" alignment="CENTER" style="-fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                <ImageView fx:id="imageView2" fitWidth="150.0" fitHeight="100.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Images/squat.jpg" />
                    </image>
                </ImageView>
                <Button text="Squats" onAction="#handleSquatsAction" prefHeight="25.0" prefWidth="132.0" />
            </VBox>
            <VBox fx:id="vbox2" spacing="10.0" alignment="CENTER" style="-fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                <ImageView fx:id="imageView3" fitWidth="150.0" fitHeight="100.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Images/wxcv.jpg" />
                    </image>
                </ImageView>
                <Button text="Sauts Américains" onAction="#handleSautsAmericainsAction" prefHeight="25.0" prefWidth="201.0" />
            </VBox>
            <VBox fx:id="vbox3" spacing="10.0" alignment="CENTER" style="-fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                <ImageView fx:id="imageView1" fitWidth="150.0" fitHeight="100.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Images/fgf.png" />
                    </image>
                </ImageView>
                <Button text="Élévation de Genoux" onAction="#handleElevationDeGenouxAction" prefHeight="25.0" prefWidth="195.0" />
            </VBox>
        </HBox>

        <!-- Titre pour la section des plans d'entraînement -->
        <Label text="Les plans d'exercices :"
               style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
               AnchorPane.leftAnchor="331.0" AnchorPane.topAnchor="335.0" />

        <!-- Section des plans d'entraînement (CoursPlansController) -->
        <VBox spacing="20.0" alignment="CENTER" AnchorPane.leftAnchor="170.0" AnchorPane.topAnchor="370.0">
            <HBox spacing="30.0" alignment="CENTER">
                <VBox spacing="10.0" alignment="CENTER" style="-fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                    <ImageView fx:id="image1" fitWidth="150.0" fitHeight="100.0" preserveRatio="true" />
                    <Button text="Agrandir" onAction="#showImage1" />
                </VBox>
                <VBox spacing="10.0" alignment="CENTER" style="-fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                    <ImageView fx:id="image2" fitWidth="150.0" fitHeight="100.0" preserveRatio="true" />
                    <Button text="Agrandir" onAction="#showImage2" />
                </VBox>
                <VBox spacing="10.0" alignment="CENTER" style="-fx-border-color: white; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 10;">
                    <ImageView fx:id="image3" fitWidth="150.0" fitHeight="100.0" preserveRatio="true" />
                    <Button text="Agrandir" onAction="#showImage3" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Bouton pour naviguer vers ListCours.fxml -->
        <Button text="Voir la liste des cours" onAction="#handleListCoursAction" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0" />
    </children>
</AnchorPane>