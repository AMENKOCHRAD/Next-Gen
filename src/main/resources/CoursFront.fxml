    <children>
        <VBox AnchorPane.leftAnchor="40.0" >
            <fx:include source="Navbar.fxml" />
            <FlowPane fx:id="coursesFlowPane" hgap="10.0" layoutX="50.0" layoutY="50.0" prefWrapLength="800.0" vgap="10.0">
                <!-- Course details will be added dynamically here -->
            </FlowPane>
        </VBox>
         <Button layoutX="33.0" layoutY="439.0" onAction="#handleBackToCoursCRUD" text="Retour aux Cours" />
    </children>
</AnchorPane>
