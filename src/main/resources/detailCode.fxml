<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="Style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.DetailCodeController">

    <fx:include source="Navbar.fxml" />  <!-- Inclure la barre de navigation -->

    <!-- Conteneur principal VBox -->
    <VBox alignment="CENTER" prefHeight="595.0" prefWidth="875.0" spacing="20" style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <!-- TableView pour afficher les informations nutritionnelles -->
        <HBox alignment="CENTER_RIGHT">
            <TableView fx:id="codeBarreTable" prefHeight="371.0" prefWidth="794.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <!-- Colonnes pour les informations de base -->
                    <TableColumn fx:id="idColumn" prefWidth="50" text="ID" />
                    <TableColumn fx:id="refproduitColumn" prefWidth="100" text="Réf_Produit" />
                    <TableColumn fx:id="nomProduitColumn" prefWidth="134.0" text="Nom du Produit" />
                    <TableColumn fx:id="ingredientsColumn" prefWidth="166.0" text="Ingrédients" />
                    <TableColumn fx:id="marqueColumn" prefWidth="100" text="Marque" />
                    <TableColumn fx:id="fkUtilisateurColumn" prefWidth="100" text="Id_Utilisateur" />

                    <!-- Colonnes pour les informations nutritionnelles -->
                    <TableColumn fx:id="caloriesColumn" prefWidth="80" text="Calories" />
                    <TableColumn fx:id="proteinesColumn" prefWidth="80" text="Protéines" />
                    <TableColumn fx:id="glucidesColumn" prefWidth="80" text="Glucides" />
                    <TableColumn fx:id="lipidesColumn" prefWidth="80" text="Lipides" />

                    <!-- Colonne pour les actions -->
                    <TableColumn fx:id="actionsColumn" prefWidth="250.0" text="Actions" />
                </columns>
            </TableView>
        </HBox>

        <!-- HBox pour aligner les boutons horizontalement -->
        <HBox alignment="CENTER" spacing="10">
            <!-- Bouton pour ajouter un code-barre -->
            <Button onAction="#goToAjouterCodeBarre" style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" text="Ajouter un Code-Barre" />
            <Button onAction="#goToListedesNutrition" style="-fx-font-size: 14px; -fx-background-color: 008CBA; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" text="Retour Liste des Nutrition" />
        </HBox>
    </VBox>

    <!-- Positionner VBox dans l'AnchorPane -->
    <AnchorPane.topAnchor>0.0</AnchorPane.topAnchor>
    <AnchorPane.bottomAnchor>0.0</AnchorPane.bottomAnchor>
    <AnchorPane.leftAnchor>0.0</AnchorPane.leftAnchor>
    <AnchorPane.rightAnchor>0.0</AnchorPane.rightAnchor>
</AnchorPane>
