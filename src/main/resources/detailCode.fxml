<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="Style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.DetailCodeController">

    <fx:include source="Navbar.fxml" />  <!-- Conteneur principal VBox -->
    <VBox alignment="CENTER" prefHeight="595.0" prefWidth="875.0" spacing="20" style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <!-- TableView déplacé plus à droite avec une largeur plus grande -->
        <HBox alignment="CENTER_RIGHT">
            <TableView fx:id="codeBarreTable" prefHeight="371.0" prefWidth="795.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="50" text="ID" />
                    <TableColumn fx:id="nomProduitColumn" prefWidth="150" text="Nom du Produit" />
                    <TableColumn fx:id="ingredientsColumn" prefWidth="150" text="Ingrédients" />
                    <TableColumn fx:id="marqueColumn" prefWidth="100" text="Marque" />
                    <TableColumn fx:id="fkUtilisateurColumn" prefWidth="100" text="Id_Utilisateur" />
                    <TableColumn fx:id="actionsColumn" prefWidth="219.0" text="Actions" />
                </columns>
            </TableView>
        </HBox>

        <!-- HBox pour aligner les boutons horizontalement -->
        <HBox alignment="CENTER" spacing="10">
            <!-- Bouton pour ajouter un code-barre -->
            <Button onAction="#goToAjouterCodeBarre" style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" text="Ajouter un Code-Barre" />

            <!-- Nouveau bouton "Retour Liste Code à Barre" aligné à droite -->
            <Button onAction="#goToListedesNutrition" style="-fx-font-size: 14px; -fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" text="Retour Liste des Nutrition" />
        </HBox>
    </VBox>

    <!-- Positionner VBox dans l'AnchorPane -->
    <AnchorPane.topAnchor>0.0</AnchorPane.topAnchor>
    <AnchorPane.bottomAnchor>0.0</AnchorPane.bottomAnchor>
    <AnchorPane.leftAnchor>0.0</AnchorPane.leftAnchor>
    <AnchorPane.rightAnchor>0.0</AnchorPane.rightAnchor>
</AnchorPane>
