<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3A8.controllers.DetailsCommande_userController">
    <children>
        <!-- Barre de navigation -->
        <fx:include source="Navbar.fxml" />

        <!-- Formulaire pour ajouter une commande -->
        <VBox layoutX="293.0" layoutY="75.0" prefHeight="383.0" prefWidth="262.0" spacing="10.0">
            <Label text="Produit:" textFill="#fafafa">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <ComboBox fx:id="produitComboBox" />

            <Label text="idClient:" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="idClientField" />
            <Label text="Quantité:" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="quantiteField" />

            <Label text="Adresse:" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="adresseField" />

            <Label text="Adresse Email:" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="emailField" />

            <Label text="Prix Total:" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="prixTotalField" editable="false" />
        </VBox>

        <!-- Bouton pour valider la commande -->
        <Button fx:id="validerCommandeButton" layoutX="571.0" layoutY="445.0" onAction="#handleValiderCommande" prefHeight="34.0" prefWidth="122.0" style="-fx-background-color: #6a11cb;" text="Valider" />
    </children>
</AnchorPane>
