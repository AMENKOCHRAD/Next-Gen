<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gestion.pidev.controllers.CoursCRUDController">
    <children>
        <VBox>
            <fx:include source="Navbar.fxml" />
            <AnchorPane prefHeight="350.0" prefWidth="875.0">
                <children>
                    <TableView fx:id="coursTable" layoutX="63.0" layoutY="39.0" prefHeight="275.0" prefWidth="784.0">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
                            <TableColumn fx:id="typeColumn" prefWidth="150.0" text="Type" />
                            <TableColumn fx:id="nomCoursColumn" prefWidth="150.0" text="Nom Cours" />
                            <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                            <TableColumn fx:id="adresseMailCoachColumn" prefWidth="150.0" text="Adresse Mail Coach" />
                            <TableColumn fx:id="imageColumn" prefWidth="150.0" text="Image" />
                        </columns>
                    </TableView>
                    <Button layoutX="740.0" layoutY="326.0" mnemonicParsing="false" onAction="#handleAdd" prefHeight="25.0" prefWidth="108.0" text="Ajouter" />
                    <Button layoutX="270.0" layoutY="326.0" mnemonicParsing="false" onAction="#handleCoursTypeCRUD" text="Gérer Types de Cours" />
                    <Button layoutX="72.0" layoutY="326.0" mnemonicParsing="false" onAction="#handleListCours" prefHeight="25.0" prefWidth="163.0" text="Liste des Cours" />
                 <!-- Bouton Exercices guidés -->
                 <Button layoutX="461.0" layoutY="325.0" mnemonicParsing="false" onAction="#handleCoursFront" text="Exercices guidés" />
                 <!-- Bouton Stats -->
                 <Button layoutX="628.0" layoutY="326.0" mnemonicParsing="false" onAction="#handleStats" prefHeight="25.0" prefWidth="85.0" text="Stats" />
                </children>
            </AnchorPane>
        </VBox>
           <Button layoutX="742.0" layoutY="446.0" mnemonicParsing="false" onAction="#handleDelete" prefHeight="25.0" prefWidth="108.0" styleClass="button-delete" text="Supprimer" />
           <Button layoutX="742.0" layoutY="411.0" mnemonicParsing="false" onAction="#handleUpdate" prefHeight="25.0" prefWidth="108.0" text="Modifier" />
    </children>
</AnchorPane>
