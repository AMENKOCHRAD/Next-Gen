<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="boutons.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ajouterTicket">

    <!-- Conteneur principal centré -->
    <VBox alignment="CENTER" layoutX="199.0" layoutY="97.0" prefWidth="475.0" spacing="15.0">

        <!-- Titre stylisé et centré -->
        <Label style="-fx-text-fill: #FFFFFF;" text="Ajouter un Ticket">
            <font>
                <Font name="Arial Bold" size="26.0" />
            </font>
        </Label>

        <!-- Conteneur des champs -->
        <VBox prefWidth="400.0" spacing="10.0">
            <Label style="-fx-text-fill: #FFFFFF;" text="ID Ticket">
                <font>
                    <Font name="Arial" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="idTicketField" promptText="Entrez l'ID du ticket" style="-fx-pref-height: 35px; -fx-background-radius: 5px;" />

            <Label style="-fx-text-fill: #FFFFFF;" text="ID Event">
                <font>
                    <Font name="Arial" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="idEventField" promptText="Entrez l'ID de l'événement" style="-fx-pref-height: 35px; -fx-background-radius: 5px;" />

            <Label style="-fx-text-fill: #FFFFFF;" text="Prix">
                <font>
                    <Font name="Arial" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="prixField" promptText="Entrez le prix du ticket" style="-fx-pref-height: 35px; -fx-background-radius: 5px;" />

            <Label style="-fx-text-fill: #FFFFFF;" text="Quantité">
                <font>
                    <Font name="Arial" size="14.0" />
                </font>
            </Label>
            <TextField fx:id="quantiteField" promptText="Entrez la quantité du ticket" style="-fx-pref-height: 35px; -fx-background-radius: 5px;" />
        </VBox>

        <!-- Bouton stylisé -->
        <Button onAction="#handleAddTicket" style="-fx-background-color: #2980B9; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5px; -fx-pref-width: 150px; -fx-pref-height: 40px;" text="Ajouter" />
    </VBox>

</AnchorPane>
