<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="boutons.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="controllers.detailsTicket">
    <fx:include source="Navbar.fxml" />
    <VBox layoutX="134.0" layoutY="97.0" prefHeight="402.0" prefWidth="588.0" spacing="10">
        <TableView fx:id="ticketTable" prefHeight="334.0" prefWidth="557.0">
            <columns>
                <TableColumn fx:id="idTicketColumn" prefWidth="140.0" text="ID Ticket">
                    <cellValueFactory>
                        <PropertyValueFactory property="idticket" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="idEventColumn" prefWidth="160.0" text="ID Event">
                    <cellValueFactory>
                        <PropertyValueFactory property="idevent" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="prixColumn" prefWidth="160.0" text="Prix ">
                    <cellValueFactory>
                        <PropertyValueFactory property="prix" />
                    </cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="quantiteColumn" prefWidth="140.0" text="Quantité">
                    <cellValueFactory>
                        <PropertyValueFactory property="quantite" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="ajoutButton" onAction="#handleAddTicket" text="Ajouter un Ticket" />
            <Button fx:id="modifyTicketButton" onAction="#handleModifyTicket" text="Modifier Ticket" />
            <Button fx:id="deleteTicketButton" onAction="#handleDeleteButton" text="Supprimer Ticket" />
        </HBox>
    </VBox>
</AnchorPane>
