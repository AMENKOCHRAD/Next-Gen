<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3A8.controllers.PanierController">

    <VBox spacing="10" alignment="CENTER" prefWidth="400" prefHeight="500">
        <!-- TableView pour afficher les produits du panier -->
        <TableView fx:id="panierTable" prefHeight="300">
            <columns>
                <TableColumn fx:id="nomColumn" text="Produit" prefWidth="200"/>
                <TableColumn fx:id="prixColumn" text="Prix (€)" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Texte pour afficher le total du panier -->
        <Text fx:id="totalText" text="Total : 0 €" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <!-- Boutons pour gérer le panier -->
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="supprimerButton" text="Supprimer" onAction="#handleSupprimerProduit" disable="true"/>
            <Button fx:id="viderButton" text="Vider" onAction="#handleViderPanier" disable="true"/>
        </HBox>
    </VBox>

</AnchorPane>
