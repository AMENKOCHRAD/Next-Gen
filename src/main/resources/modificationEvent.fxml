<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="boutons.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModificationEventController">
    <VBox layoutX="214.0" layoutY="57.0" prefHeight="428.0" prefWidth="462.0" spacing="10">
        <!-- Titre centré -->
        <Label text="Modifier l'événement" textAlignment="CENTER" textFill="#f7f2f2">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
            <style>
                -fx-alignment: CENTER;
                -fx-max-width: Infinity;
            </style>
        </Label>

        <Label text="Nom" textFill="WHITE">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <TextField fx:id="nomField" prefHeight="26.0" prefWidth="390.0" />

        <Label text="Type" textFill="WHITE">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <TextField fx:id="typeField" />

        <Label text="Date de début" textFill="WHITE">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <DatePicker fx:id="dateDebutPicker" />

        <Label text="Date de fin" textFill="WHITE">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <DatePicker fx:id="dateFinPicker" />

        <Label text="Lieu" textFill="#fcfcfc">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <TextField fx:id="lieuField" />

        <Button onAction="#handleModifyButton" text="Valider les modifications">
            <font>
                <Font size="19.0" />
            </font>
        </Button>
    </VBox>
</AnchorPane>