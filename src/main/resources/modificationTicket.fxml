<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="boutons.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModificationTicketController">

    <!-- Conteneur principal : VBox avec alignement centré -->
    <VBox alignment="CENTER" layoutX="221.0" layoutY="68.0" prefHeight="402.0" prefWidth="455.0" spacing="10">

        <!-- Titre de la page centré -->
        <Label fx:id="titreLabel" maxWidth="Infinity" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-alignment: center; -fx-font-family: 'Roboto'; -fx-text-fill: WHITE;" text="Modifier le Ticket" textAlignment="CENTER" />

        <!-- Champ pour l'ID de l'événement -->
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Roboto'; -fx-text-fill: WHITE;" text="ID Event" />
        <TextField fx:id="idEventField" prefHeight="38.0" prefWidth="455.0" style="-fx-font-family: 'Roboto';" />

        <!-- Champ pour le prix -->
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Roboto'; -fx-text-fill: WHITE;" text="Prix" />
        <TextField fx:id="prixField" prefHeight="39.0" prefWidth="455.0" style="-fx-font-family: 'Roboto';" />

        <!-- Champ pour la quantité -->
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Roboto'; -fx-text-fill: WHITE;" text="Quantité" />
        <TextField fx:id="quantiteField" prefHeight="39.0" prefWidth="455.0" style="-fx-font-family: 'Roboto';" />

        <!-- Bouton pour valider les modifications, centré -->
        <Button onAction="#handleModifyTicket" prefHeight="38.0" prefWidth="234.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #2980B9; -fx-background-radius: 5px; -fx-font-family: 'Roboto'; -fx-text-fill: WHITE;" text="Valider les modifications" />

    </VBox>

</AnchorPane>