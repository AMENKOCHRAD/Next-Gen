<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" style="-fx-background-color: #f0f0f0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.ModifierReclamationController">
    <children>
        <VBox layoutX="50.0" layoutY="50.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 10, 0, 0;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <children>
                <Label text="Modifier Réclamation" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
                <TextField fx:id="sujetTextField" promptText="Sujet" style="-fx-font-size: 16;"/>
                <TextField fx:id="descriptionTextField" promptText="Description" style="-fx-font-size: 16;"/>
                <ComboBox fx:id="categorieComboBox" promptText="Catégorie" style="-fx-font-size: 16;" prefWidth="200.0" />

                <!-- Liste des pièces jointes -->
                <Label text="Pièces jointes :" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-padding: 0;">
                    <content>
                        <ListView fx:id="piecesJointesListView" style="-fx-background-color: transparent; -fx-border-color: #dddddd; -fx-border-radius: 10; -fx-padding: 10;" prefHeight="100.0" prefWidth="500.0"/>
                    </content>
                </ScrollPane>

                <!-- Boutons -->
                <Button text="Ajouter une pièce jointe" onAction="#handleAjouterPieceJointe" style="-fx-background-color: #33b5e5; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button text="Enregistrer" onAction="#handleEnregistrer" style="-fx-background-color: #33b5e5; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>