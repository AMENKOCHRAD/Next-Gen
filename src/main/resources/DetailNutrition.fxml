<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="Style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.DetailNutritionController">

    <fx:include source="Navbar.fxml" />
    <!-- Conteneur principal VBox -->
    <VBox alignment="CENTER" layoutY="-9.0" prefHeight="604.0" prefWidth="875.0" spacing="20" style="-fx-background-color: transparent;">
        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <Accordion />

        <!-- Barre de recherche -->
        <HBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="5.0" prefWidth="815.0" scaleZ="0.5" spacing="5.0">
            <TextField fx:id="searchField" prefHeight="32.0" prefWidth="300.0" promptText="Rechercher par poids..." style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5px; -fx-padding: 5px;" />
            <Button onAction="#handleSearch" style="-fx-font-size: 14px; -fx-background-color: #008CBA; -fx-text-fill: white; -fx-padding: 5 10; -fx-background-radius: 5;" text="Rechercher" />
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets left="20" />
            </padding>

            <TableView fx:id="nutritionTable" prefHeight="378.0" prefWidth="797.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="50" style="-fx-text-fill: #2c3e50;" text="ID" />
                    <TableColumn fx:id="idUtilisateurColumn" prefWidth="50" style="-fx-text-fill: #2c3e50;" text="ID_utlisateur" />
                    <TableColumn fx:id="poidsColumn" prefWidth="84.0" style="-fx-text-fill: #2c3e50;" text="Poids (kg)" />
                    <TableColumn fx:id="tailleColumn" prefWidth="92.0" style="-fx-text-fill: #2c3e50;" text="Taille (cm)" />
                    <TableColumn fx:id="sexeColumn" prefWidth="124.0" style="-fx-text-fill: #2c3e50;" text="Sexe" />
                    <TableColumn fx:id="imcColumn" prefWidth="79.0" style="-fx-text-fill: #2c3e50;" text="IMC" />
                    <TableColumn fx:id="actionsColumn" prefWidth="365.0" style="-fx-text-fill: #2c3e50;" text="Actions" />
                </columns>
            </TableView>
        </HBox>

        <!-- HBox pour aligner les boutons horizontalement -->
        <HBox alignment="CENTER" spacing="10">
            <!-- Bouton pour ajouter une nutrition -->
            <Button onAction="#goToAjouterNutrition" style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" text="Ajouter une nutrition" />
            <Button onAction="#goToscanner" style="-fx-font-size: 14px; -fx-background-color:#008CBA ; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" text="scanner repas" />
            <!-- Nouveau bouton "Gestion Code à barre" aligné à droite -->
            <Button onAction="#goToGestionCodeBarre" style="-fx-font-size: 14px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;" text="Gestion Code à Barre" />
        </HBox>
    </VBox>

    <!-- Positionner VBox dans l'AnchorPane -->
    <AnchorPane.topAnchor>0.0</AnchorPane.topAnchor>
    <AnchorPane.bottomAnchor>0.0</AnchorPane.bottomAnchor>
    <AnchorPane.leftAnchor>0.0</AnchorPane.leftAnchor>
    <AnchorPane.rightAnchor>0.0</AnchorPane.rightAnchor>
</AnchorPane>
