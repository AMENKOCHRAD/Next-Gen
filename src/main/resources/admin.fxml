<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="@navbar.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.admin">

    <children>
        <ImageView fitHeight="500.0" fitWidth="875.0" layoutX="-1.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@Images/background_admin.png" />
            </image>
        </ImageView>
        <fx:include source="Navbar.fxml" />
        <TableView fx:id="table_adherents" layoutX="37.0" layoutY="73.0" prefHeight="348.0" prefWidth="826.0">
            <columns>
                <TableColumn fx:id="column_id" prefWidth="40.0" text="ID" />
                <TableColumn fx:id="column_email" prefWidth="78.0" text="Email" />
                <TableColumn fx:id="column_mdp" prefWidth="58.0" text="MDP" />
                <TableColumn fx:id="column_nom" prefWidth="73.0" text="Nom" />
                <TableColumn fx:id="column_prenom" prefWidth="70.0" text="Prenom" />
                <TableColumn fx:id="column_date" prefWidth="81.0" text="Date Naissance" />
                <TableColumn fx:id="column_numTel" prefWidth="67.0" text="NumTel" />
                <TableColumn fx:id="column_genre" prefWidth="69.0" text="Genre" />
                <TableColumn fx:id="column_adresse" prefWidth="72.0" text="Adresse" />
                <TableColumn fx:id="column_role" prefWidth="72.0" text="Role" />
                <TableColumn fx:id="column_banned" prefWidth="65.0" text="Banned" />
                <TableColumn fx:id="column_image" prefWidth="118.0" text="Image" />
            </columns>
        </TableView>
        <Button fx:id="ajout_adherent_button" layoutX="53.0" layoutY="437.0" mnemonicParsing="false" onAction="#handleAddAdherent" prefHeight="40.0" prefWidth="150.0" stylesheets="@ButtonStyle.css" text="Ajouter Un Adherent">
            <font>
                <Font size="10.0" />
            </font>
        </Button>
        <Button fx:id="modifier_adherent_button" layoutX="212.0" layoutY="437.0" mnemonicParsing="false" onAction="#handleUpdateAdherent" prefHeight="40.0" prefWidth="150.0" stylesheets="@ButtonStyle.css" text="Modifier Un Adherent" />
        <Button fx:id="supprimer_adherent_button" layoutX="370.0" layoutY="437.0" mnemonicParsing="false" onAction="#handleDeleteAdherent" prefHeight="40.0" prefWidth="150.0" stylesheets="@ButtonStyle.css" text="Supprimer Un Adherent" />
        <Button fx:id="gerer_coachs_button" layoutX="529.0" layoutY="437.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="150.0" stylesheets="@ButtonStyle.css" text="Gerer Coachs" />
        <Button fx:id="userStatisticsButton" layoutX="687.0" layoutY="437.0" mnemonicParsing="false" onAction="#handleUserStatisticsButtonAction" prefHeight="40.0" prefWidth="160.0" stylesheets="@ButtonStyle.css" text="User Statistics" />
    </children>
</AnchorPane>
