<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="767.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3A8.controllers.DetailsController" stylesheets="@styles.css">
    <children>
        <!-- TableView pour afficher les produits -->
        <TableView fx:id="produitTable" prefHeight="318.0" prefWidth="767.0" layoutX="0.0" layoutY="0.0">
            <columns>
                <!-- Colonne ID -->
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID">
                    <cellValueFactory>
                        <PropertyValueFactory property="id_produit" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Nom -->
                <TableColumn fx:id="nomColumn" prefWidth="96.8" text="Nom">
                    <cellValueFactory>
                        <PropertyValueFactory property="nom_produit" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Type -->
                <TableColumn fx:id="typeColumn" prefWidth="79.2" text="Type">
                    <cellValueFactory>
                        <PropertyValueFactory property="type_produit" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Prix -->
                <TableColumn fx:id="prixColumn" prefWidth="98.4" text="Prix">
                    <cellValueFactory>
                        <PropertyValueFactory property="prix" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne État -->
                <TableColumn fx:id="etatColumn" prefWidth="91.2" text="État">
                    <cellValueFactory>
                        <PropertyValueFactory property="etat" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Description -->
                <TableColumn fx:id="descriptionColumn" prefWidth="118.4" text="Description">
                    <cellValueFactory>
                        <PropertyValueFactory property="description" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Statut -->
                <TableColumn fx:id="statusColumn" prefWidth="88.0" text="Statut">
                    <cellValueFactory>
                        <PropertyValueFactory property="status" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Colonne Image -->
                <TableColumn fx:id="imageColumn" prefWidth="147.2" text="Image">
                    <cellValueFactory>
                        <PropertyValueFactory property="image" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Boutons supplémentaires dans un HBox -->
        <HBox layoutX="14.0" layoutY="330.0" spacing="10">
            <!-- Bouton Ajouter un produit -->
            <Button fx:id="ajouterButton" onAction="#handleAjouterProduit" text="Ajouter un produit" styleClass="button" />

            <!-- Bouton Supprimer -->
            <Button fx:id="supprimerButton" onAction="#handleSupprimerProduit" text="Supprimer" styleClass="button" />

            <!-- Bouton Modifier -->
            <Button fx:id="modifierButton" onAction="#handleModifierProduit" text="Modifier" styleClass="button" />

            <!-- Bouton Voir Commandes -->
            <Button fx:id="voirCommandesButton" onAction="#handleVoirCommandes" text="Voir Commandes" styleClass="button" />
        </HBox>
    </children>
</AnchorPane>