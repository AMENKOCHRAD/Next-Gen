<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.details">
    <fx:include source="Navbar.fxml" />

    <ImageView fitHeight="517.0" fitWidth="875.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@images/background_event.png" />
        </image>
    </ImageView>
    <fx:include source="Navbar.fxml" />
    <TableView fx:id="eventTable" layoutX="60.0" layoutY="83.0" prefHeight="334.0" prefWidth="786.0">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" />
            <TableColumn fx:id="nomColumn" minWidth="80.0" prefWidth="140.0" text="Nom" />
            <TableColumn fx:id="typeColumn" minWidth="80.0" prefWidth="140.0" text="Type" />
            <TableColumn fx:id="dateDebutColumn" minWidth="80.0" prefWidth="135.0" text="Date Dèbut" />
            <TableColumn fx:id="dateFinColumn" minWidth="80.0" prefWidth="135.0" text="Date Fin" />
            <TableColumn fx:id="lieuColumn" minWidth="80.0" prefWidth="168.0" text="Lieu" />
        </columns>
    </TableView>

    <Button fx:id="ajoutButton" layoutX="69.0" layoutY="440.0" mnemonicParsing="false" onAction="#handleAddEvent" prefHeight="36.0" prefWidth="162.0" stylesheets="@boutons.css" text="Ajouter evenement" />
    <Button fx:id="deleteButton" layoutX="255.0" layoutY="440.0" mnemonicParsing="false" onAction="#handleDeleteButton" prefHeight="36.0" prefWidth="182.0" stylesheets="@boutons.css" text="Supprimer evenement" />
    <Button fx:id="modifyButton" layoutX="453.0" layoutY="440.0" mnemonicParsing="false" onAction="#handleModifyButton" prefHeight="36.0" prefWidth="182.0" stylesheets="@boutons.css" text="Modifier evenement" />
    <Button fx:id="GestionButton" layoutX="655.0" layoutY="440.0" mnemonicParsing="false" onAction="#GoToGestionTicket" prefHeight="36.0" prefWidth="182.0" stylesheets="@boutons.css" text="Gestion des Tickets" />
</AnchorPane>
