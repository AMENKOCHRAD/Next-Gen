<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="512.0" prefWidth="854.0" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.TicketController">
   <fx:include source="Navbar.fxml" />
   <AnchorPane layoutX="-2.0" layoutY="61.0" prefHeight="422.0" prefWidth="877.0">
      <children>
         <ImageView fitHeight="501.0" fitWidth="876.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../images/background_event.png" />
            </image>
         </ImageView>
      
          <Label layoutX="357.0" layoutY="9.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestion des Tickets" />
      
          <Label layoutX="100.0" layoutY="145.0" text="Prix :" />
          <TextField fx:id="prixField" layoutX="171.0" layoutY="141.0" />
          <Label fx:id="prixError" textFill="red" />
      
          <Label layoutX="100.0" layoutY="179.0" text="Quantité :" />
          <TextField fx:id="quantiteField" layoutX="171.0" layoutY="175.0" />
          <Label fx:id="quantiteError" textFill="red" />
      
          <Label layoutX="100.0" layoutY="217.0" text="Événement :" />
          <ComboBox fx:id="eventComboBox" layoutX="175.0" layoutY="213.0" />
          <Label fx:id="eventError" textFill="red" />
      
          <HBox spacing="10" />
      
          <TableView fx:id="ticketTable" layoutX="472.0" layoutY="126.0" prefHeight="200" prefWidth="303.0">
              <columns>
                  <TableColumn fx:id="colPrix" prefWidth="100" text="Prix" />
                  <TableColumn fx:id="colQuantite" prefWidth="100" text="Quantité" />
                  <TableColumn fx:id="colEventName" prefWidth="100" text="Événement" />
              </columns>
          </TableView>
           <Button fx:id="btnAjouter" layoutX="104.0" layoutY="267.0" onAction="#ajouterTicket" text="Ajouter" />
           <Button fx:id="btnModifier" layoutX="175.0" layoutY="267.0" onAction="#modifierTicket" text="Modifier" />
           <Button fx:id="btnSupprimer" layoutX="256.0" layoutY="267.0" onAction="#supprimerTicket" text="Supprimer" />
           <TextField fx:id="searchField" layoutX="472.0" layoutY="348.0" prefHeight="26.0" prefWidth="162.0" promptText="Rechercher un événement..." />
   
              <Button fx:id="btnRetour" layoutX="723.0" layoutY="348.0" onAction="#handleRetour" text="Retour" />
      </children>
   </AnchorPane>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
</AnchorPane>
