<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="css/style2.css"  xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.DetailController">
   <children>
      <!-- Conteneur principal -->
      <VBox layoutX="-8.0" layoutY="17.0" prefHeight="551.0" prefWidth="1366.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 10, 0, 0;">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <!-- Titre de la page -->
            <HBox alignment="CENTER" spacing="30">

               <Label style="-fx-font-size: 38; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Liste des Réclamations" textFill="#a40ca6" />
            </HBox>

            <!-- Séparateur visuel -->

            <!-- TableView pour afficher les réclamations -->
            <TableView fx:id="reclamationsTable" layoutX="50.0" layoutY="30.0" prefHeight="350.0" prefWidth="1268.0">
               <columns>
                  <!-- Colonne ID -->
                  <TableColumn fx:id="idColumn" prefWidth="50" text="ID">
                     <cellValueFactory>
                        <PropertyValueFactory property="id" />
                     </cellValueFactory>
                  </TableColumn>

                  <!-- Colonne Sujet -->
                  <TableColumn fx:id="sujetColumn" prefWidth="150" text="Sujet">
                     <cellValueFactory>
                        <PropertyValueFactory property="sujet" />
                     </cellValueFactory>
                  </TableColumn>

                  <!-- Colonne Description -->
                  <TableColumn fx:id="descriptionColumn" prefWidth="300" text="Description">
                     <cellValueFactory>
                        <PropertyValueFactory property="description" />
                     </cellValueFactory>
                  </TableColumn>

                  <!-- Colonne Catégorie -->
                  <TableColumn fx:id="categorieColumn" prefWidth="150" text="Catégorie">
                     <cellValueFactory>
                        <PropertyValueFactory property="categorie" />
                     </cellValueFactory>
                  </TableColumn>

                  <!-- Colonne Date -->
                  <TableColumn fx:id="dateColumn" prefWidth="150" text="Date">
                     <cellValueFactory>
                        <PropertyValueFactory property="date" />
                     </cellValueFactory>
                  </TableColumn>

                  <!-- Colonne Statut -->
                  <TableColumn fx:id="statutColumn" prefWidth="100" text="Statut">
                     <cellValueFactory>
                        <PropertyValueFactory property="statut" />
                     </cellValueFactory>
                  </TableColumn>

                  <!-- Colonne Pièces jointes -->
                  <TableColumn fx:id="piecesJointesColumn" prefWidth="200" text="Pièces jointes">
                     <!-- Cette colonne sera gérée dans le contrôleur -->
                  </TableColumn>
               </columns>
            </TableView>

            <!-- Boutons Supprimer et Modifier -->
            <HBox alignment="CENTER" spacing="20">
               <Button onAction="#handleSupprimerReclamation" style="-fx-background-color: #ff4444; -fx-text-fill: white; -fx-font-weight: bold;" text="Supprimer" />
               <Button onAction="#handleModifierReclamation" style="-fx-background-color: #33b5e5; -fx-text-fill: white; -fx-font-weight: bold;" text="Modifier" />
               <Button onAction="#handleAjouterReclamation" style="-fx-background-color: #00C851; -fx-text-fill: white; -fx-font-weight: bold;" text="Ajouter une Réclamation" />
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>