<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3A8.controllers.PaymentDialogController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <Label text="Numéro de carte :" />
    <TextField fx:id="cardNumberField" />

    <Label text="Date d'expiration (MM/YY) :" />
    <TextField fx:id="expiryDateField" />

    <Label text="CVC :" />
    <TextField fx:id="cvcField" />

    <Button onAction="#handlePayment" style="-fx-background-color: #6a11cb;" text="Payer" />
</VBox>
