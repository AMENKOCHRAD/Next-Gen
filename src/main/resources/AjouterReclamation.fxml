<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.FontWeight?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: linear-gradient(to bottom right, #6a11cb, #2575fc);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3a8.controllers.AjouterReclamationController">
   <children>
      <!-- Conteneur principal -->
      <VBox alignment="CENTER" layoutX="100.0" layoutY="50.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 20, 20, 0, 0);">
         <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
         </padding>
         <children>
            <!-- Titre de la page avec icône -->
            <HBox alignment="CENTER" spacing="10">
               <ImageView fitHeight="40.0" fitWidth="40.0">
                  <image>
                  </image>
               </ImageView>
               <Label text="Ajouter une Réclamation" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            </HBox>

            <!-- Séparateur visuel -->
            <Rectangle height="2.0" width="500.0" fill="#dddddd" arcWidth="5.0" arcHeight="5.0"/>

            <!-- Champ Sujet -->
            <VBox alignment="CENTER_LEFT" spacing="5">
               <Label text="Sujet" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #555555;"/>
               <TextField fx:id="sujet_textfield" prefWidth="400.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cccccc; -fx-padding: 10;"/>
            </VBox>

            <!-- Champ Description -->
            <VBox alignment="CENTER_LEFT" spacing="5">
               <Label text="Description" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #555555;"/>
               <TextField fx:id="description_textfield" prefWidth="400.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cccccc; -fx-padding: 10;"/>
            </VBox>

            <!-- Champ Catégorie -->
            <VBox alignment="CENTER_LEFT" spacing="5">
               <Label text="Catégorie" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #555555;"/>
               <ComboBox fx:id="categorieComboBox" prefWidth="400.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cccccc; -fx-padding: 10;"/>
            </VBox>

            <!-- Bouton Ajouter une pièce jointe -->
            <Button fx:id="ajouterPieceJointeButton" text="Ajouter une pièce jointe"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 5, 0, 0);"
                    onAction="#handleAjouterPieceJointe"/>

            <!-- Liste des pièces jointes -->
            <ListView fx:id="piecesJointesListView" prefHeight="100.0" prefWidth="500.0"
                      style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cccccc; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 5, 0, 0);"/>

            <!-- Bouton Valider -->
            <Button fx:id="button" text="Valider"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 5, 0, 0);"
                    onAction="#AjouterReclamationAction"/>

            <!-- Bouton Assistance IA -->
            <Button fx:id="assistanceIAButton" text="Assistance IA"
                    style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 5, 0, 0);"
                    onAction="#handleAssistanceIA"/>
         </children>
      </VBox>
   </children>
</AnchorPane>