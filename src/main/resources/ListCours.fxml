<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="styles.css"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.pidev3a8.controllers.ListCoursController">
    <children>
        <VBox spacing="10.0" alignment="CENTER">
            <!-- Inclusion de la navbar -->
            <fx:include source="Navbar.fxml"/>
            <!-- Barre de recherche -->
            <HBox spacing="10.0" alignment="CENTER">
                <padding>
                    <Insets top="10.0" right="50.0" bottom="10.0" left="50.0"/>
                </padding>
                <TextField fx:id="searchField" promptText="Rechercher un cours" />
                <Button text="Rechercher" onAction="#handleSearch"/>
                <Button text="Optionalités" onAction="#handleExercicesGuides"/>

            </HBox>
            <!-- Zone d'affichage des cours -->
            <FlowPane fx:id="coursContainer" hgap="20.0" vgap="20.0" alignment="CENTER_LEFT"
                      prefWrapLength="875.0">
                <padding>
                    <Insets top="0.0" right="50.0" bottom="0.0" left="50.0"/>
                </padding>
                <!-- Les éléments des cours seront ajoutés dynamiquement -->
            </FlowPane>
        </VBox>
    </children>
</AnchorPane>
