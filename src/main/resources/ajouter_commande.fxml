<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3A8.controllers.AjouterCommandeController">
    <children>
        <VBox layoutX="50.0" layoutY="50.0" spacing="10.0">
            <Label text="Produit:" />
            <ComboBox fx:id="produitComboBox" />

            <Label text="ID Client:" />
            <TextField fx:id="idClientField" />

            <Label text="Quantité:" />
            <TextField fx:id="quantiteField" />

            <Label text="Prix Total:" />
            <TextField fx:id="prixTotalField" />

            <Label text="Date Commande:" />
            <DatePicker fx:id="dateCommandePicker" />

            <Label text="Statut:" />
            <ComboBox fx:id="statutComboBox" />

            <Button text="Ajouter" onAction="#handleAjouter" />
        </VBox>
    </children>
</AnchorPane>