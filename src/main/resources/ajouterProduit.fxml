<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3A8.controllers.AjouterProduitController">
    <children>
        <!-- Champs de texte pour les informations du produit -->
        <TextField fx:id="nomField" layoutX="150.0" layoutY="50.0" promptText="Nom du produit"/>
        <TextField fx:id="typeField" layoutX="150.0" layoutY="90.0" promptText="Type du produit"/>
        <TextField fx:id="prixField" layoutX="150.0" layoutY="130.0" promptText="Prix"/>
        <ComboBox fx:id="etatComboBox" layoutX="150.0" layoutY="170.0" promptText="État"/>
        <TextField fx:id="descriptionField" layoutX="150.0" layoutY="210.0" promptText="Description"/>
        <ComboBox fx:id="statusComboBox" layoutX="150.0" layoutY="250.0" promptText="Statut"/>

        <!-- Labels pour les champs de texte -->
        <Label layoutX="50.0" layoutY="54.0" text="Nom"/>
        <Label layoutX="50.0" layoutY="94.0" text="Type"/>
        <Label layoutX="50.0" layoutY="134.0" text="Prix"/>
        <Label layoutX="50.0" layoutY="174.0" text="État"/>
        <Label layoutX="50.0" layoutY="214.0" text="Description"/>
        <Label layoutX="50.0" layoutY="254.0" text="Statut"/>

        <!-- Bouton pour sélectionner une image -->
        <Button fx:id="uploadButton" layoutX="50.0" layoutY="290.0" text="Sélectionner une image" onAction="#handleUploadImage"/>

        <!-- Label pour afficher le nom du fichier image -->
        <Label fx:id="imageLabel" layoutX="200.0" layoutY="294.0" text="Aucune image sélectionnée"/>

        <!-- ImageView pour afficher un aperçu de l'image -->
        <ImageView fx:id="imagePreview" fitWidth="100" fitHeight="100" preserveRatio="true" layoutX="400.0" layoutY="50.0"/>

        <!-- Bouton pour ajouter le produit -->
        <Button fx:id="ajouterButton" layoutX="250.0" layoutY="330.0" text="Ajouter" onAction="#handleAjouterProduit"/>
    </children>
</AnchorPane>