<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="875.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.pidev3A8.controllers.AjouterProduitController">
    <children>
        <!-- Barre de navigation -->
        <fx:include source="Navbar.fxml">

        </fx:include>
        <!-- Champs de texte pour les informations du produit -->
        <TextField fx:id="nomField" layoutX="378.0" layoutY="81.0" prefHeight="26.0" prefWidth="195.0" promptText="Nom du produit" />
        <TextField fx:id="typeField" layoutX="381.0" layoutY="144.0" prefHeight="26.0" prefWidth="195.0" promptText="Type du produit" />
        <TextField fx:id="prixField" layoutX="381.0" layoutY="205.0" prefHeight="26.0" prefWidth="195.0" promptText="Prix" />
        <ComboBox fx:id="etatComboBox" layoutX="385.0" layoutY="265.0" prefHeight="26.0" prefWidth="90.0" promptText="État" />
        <TextField fx:id="descriptionField" layoutX="384.0" layoutY="329.0" promptText="Description" />
        <ComboBox fx:id="statusComboBox" layoutX="385.0" layoutY="393.0" prefHeight="26.0" prefWidth="90.0" promptText="Statut" />

        <!-- Labels pour les champs de texte -->
        <Label layoutX="381.0" layoutY="58.0" text="Nom:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
        <Label layoutX="379.0" layoutY="116.0" text="Type:" textFill="#fffefe">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
        <Label layoutX="382.0" layoutY="181.0" text="Prix:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
        <Label layoutX="385.0" layoutY="240.0" prefHeight="18.0" prefWidth="50.0" text="État:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
        <Label layoutX="383.0" layoutY="302.0" text="Description:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
        <Label layoutX="388.0" layoutY="369.0" text="Statut:" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>

        <!-- Bouton pour sélectionner une image -->
        <Button fx:id="uploadButton" layoutX="381.0" layoutY="436.0" onAction="#handleUploadImage" text="Sélectionner une image" />

        <!-- Label pour afficher le nom du fichier image -->
        <Label fx:id="imageLabel" layoutX="167.0" layoutY="446.0" text="Aucune image sélectionnée" textFill="WHITE">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>

        <!-- ImageView pour afficher un aperçu de l'image -->
        <ImageView fx:id="imagePreview" fitHeight="100" fitWidth="100" layoutX="632.0" layoutY="130.0" preserveRatio="true" />

        <!-- Bouton pour ajouter le produit -->
        <Button fx:id="ajouterButton" layoutX="760.0" layoutY="445.0" onAction="#handleAjouterProduit" text="Ajouter" />
    </children>
</AnchorPane>
